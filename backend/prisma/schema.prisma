generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                    @id @default(uuid())
  email                 String                    @unique
  name                  String
  avatarUrl             String?
  oauthAccounts         OAuthAccount[]
  mediaCount            Int                       @default(0)
  followerCount         Int                       @default(0)
  followingCount        Int                       @default(0)
  totalLikesReceived    Int                       @default(0)
  totalLikesGiven       Int                       @default(0)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  blocksReceived        Block[]                   @relation("UserBlocked")
  blocksInitiated       Block[]                   @relation("UserBlocker")
  bookmarks             Bookmark[]
  conversations         ConversationParticipant[]
  following             Follower[]                @relation("UserFollowing")
  followers             Follower[]                @relation("UserFollowers")
  likes                 Like[]
  media                 Media[]
  sentMessages          Message[]                 @relation("SentMessages")
  notificationsCreated  Notification[]            @relation("NotificationActor")
  notificationsReceived Notification[]            @relation("NotificationTarget")
  comments              ThreadedComment[]
  stats                 UserStats?
  reports               Report[]
}

model OAuthAccount {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@index([userId])
}

model Media {
  id            String            @id @default(uuid())
  url           String
  thumbnailUrl  String?
  type          MediaType
  title         String?
  description   String?
  uploaderId    String
  likesCount    Int               @default(0)
  commentCount  Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  bookmarks     Bookmark[]
  likes         Like[]
  uploader      User              @relation(fields: [uploaderId], references: [id])
  notifications Notification[]
  comments      ThreadedComment[]
  hashtags      MediaHashtag[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, mediaId])
}

model ThreadedComment {
  id              String            @id @default(uuid())
  userId          String
  mediaId         String
  text            String
  parentCommentId String?
  isEdited        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  notifications   Notification[]
  media           Media             @relation(fields: [mediaId], references: [id])
  parentComment   ThreadedComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         ThreadedComment[] @relation("CommentReplies")
  user            User              @relation(fields: [userId], references: [id])

  @@index([mediaId])
}

model Follower {
  id            String         @id @default(uuid())
  followerId    String
  followingId   String
  createdAt     DateTime       @default(now())
  follower      User           @relation("UserFollowing", fields: [followerId], references: [id])
  following     User           @relation("UserFollowers", fields: [followingId], references: [id])
  notifications Notification[]

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id           String           @id @default(uuid())
  type         NotificationType
  actorId      String
  targetUserId String
  mediaId      String?
  commentId    String?
  followId     String?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  actor        User             @relation("NotificationActor", fields: [actorId], references: [id])
  comment      ThreadedComment? @relation(fields: [commentId], references: [id])
  follow       Follower?        @relation(fields: [followId], references: [id])
  media        Media?           @relation(fields: [mediaId], references: [id])
  targetUser   User             @relation("NotificationTarget", fields: [targetUserId], references: [id])

  @@index([targetUserId, createdAt])
  @@index([actorId])
  @@index([mediaId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, mediaId])
}

model UserStats {
  id        String   @id @default(uuid())
  userId    String   @unique
  posts     Int      @default(0)
  followers Int      @default(0)
  following Int      @default(0)
  likes     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id])
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id])

  @@unique([blockerId, blockedId])
}

model Conversation {
  id            String                    @id @default(uuid())
  createdAt     DateTime                  @default(now())
  lastMessageAt DateTime?
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  text           String?
  mediaUrl       String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Report {
  id         String           @id @default(uuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
  reporter   User             @relation(fields: [reporterId], references: [id])

  @@index([reporterId])
}

model Hashtag {
  id        String         @id @default(uuid())
  tag       String         @unique
  createdAt DateTime       @default(now())
  media     MediaHashtag[]
}

model MediaHashtag {
  id        String  @id @default(uuid())
  mediaId   String
  hashtagId String
  media     Media   @relation(fields: [mediaId], references: [id])
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id])

  @@unique([mediaId, hashtagId])
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ReportTargetType {
  MEDIA
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  ABUSE
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  SYSTEM
}
