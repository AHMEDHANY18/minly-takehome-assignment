# ---------------- Server ----------------
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# Cookie SameSite policy: lax | strict | none (defaults: dev=lax, prod=none)
COOKIE_SAMESITE=lax

# ---------------- Database (PostgreSQL) ----------------
DATABASE_URL=postgresql://minly:minly_password@localhost:5432/minly_db

# ---------------- AWS Cognito (auth) ----------------
COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_CALLBACK_URL=http://localhost:4000/v1/auth/callback
COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/your-pool-id/.well-known/jwks.json
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=your-user-pool-id
# Set to "true" to force the Cognito login screen on every login
COGNITO_FORCE_LOGIN=false

# ---------------- AWS S3 (media storage) ----------------
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ---------------- Redis (optional — trending feed cache) ----------------
# Either a single URL...
# REDIS_URL=redis://:password@localhost:6379
# ...or discrete values:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
